# ---------------------------------------------------------------------------
# Backend: https://admin.skeltonrealtygroup.com
# Frontend: https://skeltonrealtygroup.com
# Copy to .env and fill in. Never commit the real file.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

DEBUG=False
SECRET_KEY=change-me-generate-a-64-char-random-string
# Separate from SECRET_KEY so that rotating session signing does not invalidate
# every API token at the same moment, and vice versa.
JWT_SECRET=change-me-generate-a-different-64-char-random-string

ALLOWED_HOSTS=admin.skeltonrealtygroup.com
CSRF_TRUSTED_ORIGINS=https://admin.skeltonrealtygroup.com

# The public site, which reads published inventory from this API.
# Exact origins only — a wildcard with credentials enabled lets any site drive
# this API using a logged-in staff member's browser.
CORS_ALLOWED_ORIGINS=https://skeltonrealtygroup.com,https://www.skeltonrealtygroup.com
PUBLIC_SITE_URL=https://skeltonrealtygroup.com

# Moves the admin off /admin/. Not security on its own, but it takes this host
# out of the noise floor of bots probing the default path.
ADMIN_PATH=staff/

# The engine is chosen here, not in code. SQLite is only the fallback for a
# fresh checkout; production should be one of:
#
#   mysql://user:password@host:3306/srg_admin        (MySQL 8.0.16 or newer)
#   postgresql://user:password@host:5432/srg_admin
#
# MySQL below 8.0.16 parses CHECK constraints and then ignores them. Fourteen
# tables rely on them — a payment cannot be zero, a property cannot have two
# primary images — so on an older server those rules simply stop applying.
DATABASE_URL=mysql://user:password@localhost:3306/srg_admin

STORAGE_BACKEND=local
MEDIA_ROOT=/var/www/srg-admin/media
MEDIA_URL=/media/

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Skelton Realty Group <no-reply@skeltonrealtygroup.com>

MAILER_SYNC_KEY=

# The AI phone agent's MCP server at /api/v1/voice/mcp. Paste the same value
# into the voice platform as an "Authorization: Bearer <token>" Secret header.
# Leave blank to disable the endpoint.
VOICE_MCP_TOKEN=

# Self-guided tour slots the phone agent offers, in each home's local time.
SELF_TOUR_START_HOUR=9
SELF_TOUR_END_HOUR=18
SELF_TOUR_SLOT_MINUTES=30
SELF_TOUR_MIN_NOTICE_HOURS=2

# Read out by the phone agent. Keep in step with the site's NEXT_PUBLIC_COMPANY_*.
COMPANY_PHONE=
COMPANY_PHONE_HOURS=
COMPANY_EMAIL=
COMPANY_ADDRESS=

# Lease terms (defaults shown). The late fee is the lesser of the cap and the
# percentage; state minimum grace periods (Colorado: 7 days) apply on top.
LEASE_RENT_DUE_DAY=1
LEASE_LATE_AFTER_DAYS=5
LEASE_LATE_FEE_CAP_CENTS=5000
LEASE_LATE_FEE_BASIS_POINTS=500
LEASE_RETURNED_PAYMENT_FEE_CENTS=2500
LEASE_DEPOSIT_RETURN_DAYS=14
LEASE_ENTRY_NOTICE_HOURS=48
# Answered 24/7. Required on Texas leases.
LEASE_EMERGENCY_PHONE=

# ---------------------------------------------------------------------------
# Business policy. NOTHING HERE IS INVENTED — these are the real numbers the
# business must supply, and the public site's launch gate blocks on them.
# ---------------------------------------------------------------------------
APPLICATION_FEE_CENTS=5500
MOVE_IN_LEASE_ADMIN_FEE_CENTS=15000
DECISION_WINDOW_HOURS=24

LOG_LEVEL=INFO
